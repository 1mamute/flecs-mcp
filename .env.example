# Copy to .env (never commit .env) or set these in your MCP client configuration.

# Base URL of the FLECS REST API (required). 27750 is the FLECS default port.
FLECS_REST_URL=http://localhost:27750

# Request timeout in seconds.
FLECS_REST_TIMEOUT=5

# Verify TLS certificates when FLECS_REST_URL uses https.
FLECS_REST_VERIFY_TLS=true

# Register the tools that modify the running world (create/set/remove/enable).
FLECS_REST_ALLOW_MUTATIONS=false

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stderr.
MCP_LOG_LEVEL=INFO

# MCP transport: stdio (default) or http (streamable HTTP on MCP_HOST:MCP_PORT/mcp).
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
